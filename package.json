{
  "name": "dsh-f1-skin",
  "version": "0.4.0",
  "description": "F1 Race Control themed skin for the DeepSeek Harness Web UI — Red Bull / Ferrari / McLaren / Mercedes team themes with broadcast photo backdrops, native settings panel, dark & light.",
  "license": "MIT",
  "author": "frank-fan-818",
  "homepage": "https://github.com/frank-fan-818/dsh-f1-skin#readme",
  "bugs": {
    "url": "https://github.com/frank-fan-818/dsh-f1-skin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frank-fan-818/dsh-f1-skin.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "quality": "npm run build && npm run test:unit && npm run check && npm run release:check",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "prepublishOnly": "npm run quality"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skin",
    "theme",
    "formula-1",
    "f1",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
